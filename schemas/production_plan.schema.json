{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orvyq.local/schemas/production_plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "title", "fps", "duration_frames", "duration_seconds", "proof", "policies", "sections", "shots", "music_cues"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "title": {"type": "string", "minLength": 1},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "duration_frames": {"type": "integer", "minimum": 1},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_seconds", "boundary_frame", "semantic_end", "final_word"],
      "properties": {
        "minimum_seconds": {"type": "number", "minimum": 150},
        "boundary_frame": {"type": "integer", "minimum": 2},
        "semantic_end": {"type": "string", "minLength": 1},
        "final_word": {"type": "string", "minLength": 1}
      }
    },
    "policies": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_source_capture_min_ratio", "source_backed_min_ratio", "max_continuous_evidence_seconds", "primary_capture_min_seconds", "max_fullscreen_graphic_ratio", "max_generic_stock_ratio", "max_asset_reuse_count", "max_motif_reuse_count", "mobile_min_font_px"],
      "properties": {
        "primary_source_capture_min_ratio": {"type": "number", "minimum": 0.3, "maximum": 1},
        "source_backed_min_ratio": {"type": "number", "minimum": 0.6, "maximum": 1},
        "max_continuous_evidence_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 16},
        "primary_capture_min_seconds": {"type": "number", "minimum": 4},
        "max_fullscreen_graphic_ratio": {"type": "number", "minimum": 0, "maximum": 0.1},
        "max_generic_stock_ratio": {"type": "number", "minimum": 0, "maximum": 0.2},
        "max_asset_reuse_count": {"type": "integer", "minimum": 1},
        "max_motif_reuse_count": {"type": "integer", "minimum": 1},
        "mobile_min_font_px": {"type": "integer", "minimum": 32}
      }
    },
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "start_frame", "end_frame"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1}
        }
      }
    },
    "shots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "section_id", "start_frame", "end_frame", "visual_type", "asset", "source_ids", "claim_ids", "source_backed", "provenance_mode", "full_screen_graphic", "motif", "transition", "narration_text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "section_id": {"type": "string", "minLength": 1},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1},
          "visual_type": {"enum": ["primary_capture", "physical_evidence", "source_graphic", "contextual_footage", "generic_stock", "end_card"]},
          "asset": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "source_backed": {"type": "boolean"},
          "provenance_mode": {"enum": ["official_capture", "physical_evidence", "source_derived", "licensed_footage", "original"]},
          "trim_in_seconds": {"type": "number", "minimum": 0},
          "trim_out_seconds": {"type": "number", "minimum": 0},
          "full_screen_graphic": {"type": "boolean"},
          "motif": {"type": "string", "minLength": 1},
          "mobile_font_px": {"type": "integer", "minimum": 1},
          "transition": {
            "type": "object", "additionalProperties": false,
            "required": ["type", "duration_frames"],
            "properties": {
              "type": {"enum": ["cut", "crossfade", "dip_to_black"]},
              "duration_frames": {"type": "integer", "minimum": 0}
            }
          },
          "music_cue": {"type": "string"},
          "narration_text": {"type": "string", "minLength": 1},
          "source_line": {"type": "string", "minLength": 1}
        }
      }
    },
    "music_cues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "asset", "start_frame", "end_frame", "gain_db"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "asset": {"type": "string", "minLength": 1},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1},
          "gain_db": {"type": "number", "maximum": -8}
        }
      }
    }
  }
}
