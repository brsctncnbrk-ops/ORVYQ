{
  "name": "orvyq-production-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.core.json",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:render": "tsc -p tsconfig.render.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "orvyq": "npm run build --silent && node dist/src/cli.js",
    "ci": "npm run typecheck && npm run typecheck:render && npm run test"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "playwright": "1.54.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.489"
  },
  "devDependencies": {
    "@types/node": "24.0.15",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "typescript": "5.8.3"
  }
}
